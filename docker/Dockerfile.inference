# Inference image = the Codabench Track 2 runner image (pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime: Python 3.11,
# torch 2.4.1, torchvision, numpy, Pillow). The submitted model ZIP is self-contained and runs in this image on the
# official A10 runner (B137C: submission 1007281, Finished, 258.3 s of 300 s; B156C: submission 1011976,
# ingestion 279.0 s of 300 s). Nothing else is installed.
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime
WORKDIR /opt/upar
COPY verification_materials/code/src /opt/upar/src
COPY docker/run_inference.sh docker/evaluate_distances.py docker/official_adm.py /opt/upar/docker/
ENV PYTHONPATH=/opt/upar/src PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["bash", "/opt/upar/docker/run_inference.sh"]
